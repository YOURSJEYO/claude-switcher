<Window x:Class="ClaudeSwitcher.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置 Claude 切换器" Height="720" Width="760" MinHeight="620" MinWidth="680"
        Background="#F4F6F8" Foreground="#18212B" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="首次配置" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <Border DockPanel.Dock="Right" Background="#E5EAF0" CornerRadius="4" Padding="12,6">
                <TextBlock x:Name="PhaseText" Text="等待预览" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="代理模式" VerticalAlignment="Center" Margin="0,0,12,10" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProxyModeCombo" Margin="0,0,0,10"
                          SelectionChanged="Selection_Changed" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="代理组名" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProxyGroupText" Margin="0,0,0,10"
                         TextChanged="Selection_Changed" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="代理提示" VerticalAlignment="Top" Margin="0,0,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProxyHintText" TextWrapping="Wrap"
                           Foreground="#586574" />
                <Button Grid.Row="3" Grid.Column="1" x:Name="PreviewButton" Content="预览配置"
                        HorizontalAlignment="Left" Padding="16,8" Margin="0,14,0,0" Click="Preview_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="4" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="探测结果与系统变更" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid x:Name="ReviewPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="出口国家" Foreground="#586574" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CountryText" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows 时区" Foreground="#586574" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TimeZoneText" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="区域格式" Foreground="#586574" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CultureText" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="代理选择" Foreground="#586574" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ReviewedProxyText" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                            <TextBlock Text="应用后将执行" Foreground="#586574" Margin="0,4,0,6" />
                            <ItemsControl x:Name="EffectsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                            <Run Text="• " />
                                            <Run Text="{Binding Title}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Description}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ReviewPlaceholderText" Text="点击“预览配置”后在此核对探测结果和系统变更。"
                               Foreground="#586574" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Left" Content="关闭" Padding="16,8" Click="Close_Click" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="应用配置" Padding="16,8"
                    Click="Apply_Click" IsEnabled="False" />
        </DockPanel>
    </Grid>
</Window>
