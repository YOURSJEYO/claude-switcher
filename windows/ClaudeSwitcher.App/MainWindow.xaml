<Window x:Class="ClaudeSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude 切换器" Height="760" Width="900" MinHeight="620" MinWidth="760"
        Background="#F4F6F8" Foreground="#18212B" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="CLAUDE SWITCHER" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <Border DockPanel.Dock="Right" Background="#E5EAF0" CornerRadius="4" Padding="12,6">
                <TextBlock x:Name="StatusBadge" Text="检查中" FontWeight="SemiBold" />
            </Border>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <TextBlock x:Name="BannerText" Text="正在读取核心安全检查结果…" TextWrapping="Wrap" />
        </Border>
        <DataGrid Grid.Row="2" x:Name="ChecksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0" Background="White" BorderBrush="#DCE2E8" BorderThickness="1"
                  SelectionUnit="FullRow" MinRowHeight="34">
            <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding Icon}" Width="58">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Accent}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="检查项" Binding="{Binding Name}" Width="155" />
                <DataGridTextColumn Header="结果" Binding="{Binding Detail}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="当前账号" Foreground="#586574" VerticalAlignment="Center" />
                <TextBlock x:Name="CurrentAccountText" Text="—" FontSize="18" FontWeight="Bold" Margin="10,0,22,0" VerticalAlignment="Center" />
                <Button x:Name="SwitchAButton" Content="切换到 A" Padding="14,8" Margin="0,0,8,0" Click="SwitchA_Click" />
                <Button x:Name="SwitchBButton" Content="切换到 B" Padding="14,8" Click="SwitchB_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="重新检查" Padding="14,8" Margin="0,0,8,0" Click="Refresh_Click" />
                <Button x:Name="FixButton" Content="一键修复" Padding="14,8" Margin="0,0,8,0" Click="Fix_Click" />
                <Button x:Name="ConfigureButton" Content="配置安装" Padding="14,8" Click="Configure_Click" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="4" x:Name="OperationText" Foreground="#586574" Margin="0,12,0,0" Text="" TextWrapping="Wrap" />
    </Grid>
</Window>
