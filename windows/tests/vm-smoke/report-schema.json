{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-switcher/windows-vm-acceptance-report.schema.json",
  "title": "ClaudeSwitcher Windows VM acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "reportType",
    "sourceCommit",
    "version",
    "installer",
    "signer",
    "environments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "ClaudeSwitcher"
    },
    "reportType": {
      "const": "windows-vm-acceptance"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z]+)*)?$"
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^ClaudeSwitcher-[0-9A-Za-z.-]+-windows-setup\\.exe$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "keyProtection"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9 _-]{0,127}$"
        },
        "keyProtection": {
          "const": "external-secret-store; WINDOWS_VM_REPORT_HMAC_KEY >= 32 UTF-8 bytes"
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "os",
          "executed",
          "scenarios"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "os": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "version",
              "build",
              "architecture",
              "dotnetRuntimeInstalled"
            ],
            "properties": {
              "family": {
                "enum": [
                  "windows-10",
                  "windows-11"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^(?:[0-9]{2}H[12]|Windows (?:10|11) [0-9]{2}H[12])$"
              },
              "build": {
                "type": "string",
                "minLength": 1,
                "maxLength": 15,
                "pattern": "^(?:19045\\.[0-9]{1,6}|(?:2[2-9][0-9]{3}|[3-9][0-9]{4})(?:\\.[0-9]{1,6})?)$"
              },
              "architecture": {
                "const": "x64"
              },
              "dotnetRuntimeInstalled": {
                "type": "boolean"
              }
            }
          },
          "executed": {
            "const": true
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result",
                "startedAt",
                "finishedAt",
                "diagnostics",
                "executed"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "result": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "not-run"
                  ]
                },
                "startedAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
                },
                "finishedAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
                },
                "diagnostics": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "summary"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "setup-exit",
                          "app-launch",
                          "first-run-state",
                          "os-build",
                          "identity",
                          "task",
                          "acl",
                          "account-data",
                          "packaged-files",
                          "cancellation",
                          "helper-stage",
                          "recovery",
                          "concurrency",
                          "result",
                          "environment"
                        ]
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "pattern": "^(?!.*[\\x00-\\x1f\\x7f-\\x9f])(?![\\s\\S]*(?:[0-9]{1,3}\\.){3}[0-9]{1,3})(?![\\s\\S]*[0-9A-Fa-f]{0,4}:[0-9A-Fa-f:.]{2,})(?![\\s\\S]*(?:country|country[_-]?code|loc|location|egress(?:[_-]?ip)?)\\s*[:=])(?![\\s\\S]*[\\\"']?\\b(?:access[_-]?token|refresh[_-]?token|auth[_-]?token|api[_-]?key|apikey|access[_-]?key|client[_-]?secret|aws[_-]?secret[_-]?access[_-]?key|token|password|passwd|secret|private[_-]?key|authorization|cookie|session[_-]?id)\\b[\\\"']?\\s*[:=])(?![\\s\\S]*(?:https?|ftp)://)(?![\\s\\S]*(?:[A-Za-z]:\\\\|%USERPROFILE%[\\\\/]|/(?:Users|home|root|tmp|var/tmp)/))(?![\\s\\S]*\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b)(?![\\s\\S]*(?:\\bsk-(?:proj-|svcacct-|live-|test-)?[A-Za-z0-9_-]{16,}\\b|\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\\b|\\bgithub_pat_[A-Za-z0-9_]{20,}\\b|\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b|\\b(?:Bearer|Basic)\\s+[A-Za-z0-9._~+/=-]{8,}|\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b|\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b|\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\\b|\\bAIza[0-9A-Za-z_-]{30,}\\b|\\bnpm_[A-Za-z0-9]{20,}\\b|-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY-----))[\\s\\S]*$"
                      }
                    }
                  }
                },
                "executed": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  }
}
